generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  createdAt    DateTime       @default(now())
  subjects     Subject[]
  sessions     StudySession[]
  goals        Goal[]
  plannedTasks PlannedTask[]
}

model Subject {
  id           String         @id @default(cuid())
  studentId    String
  name         String
  createdAt    DateTime       @default(now())
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessions     StudySession[]
  goals        Goal[]
  plannedTasks PlannedTask[]

  @@unique([studentId, name])
}

model StudySession {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  date      DateTime
  minutes   Int
  notes     String?
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([studentId, date])
  @@index([studentId, subjectId, date])
}

model Goal {
  id            String   @id @default(cuid())
  studentId     String
  subjectId     String
  targetMinutes Int
  period        String
  createdAt     DateTime @default(now())
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, period])
}

model PlannedTask {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  date      DateTime
  startTime String
  endTime   String
  objective String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([studentId, date])
  @@index([studentId, subjectId, date])
}
